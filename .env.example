# ---------------------------------------------------------------------------
# CareerBridge environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Required — PostgreSQL (Neon in production)
DATABASE_URL=postgresql://user:postgres@host:5432/careerbridge

# ---------------------------------------------------------------------------
# Authentication
# CareerBridge uses an auth abstraction (src/auth). When Clerk keys are present
# the Clerk adapter is used; otherwise first-party secure sessions are used so
# the app keeps working in development.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx

# ---------------------------------------------------------------------------
# AI provider (optional). Without a key the mentor answers only from retrieved
# sources — it never invents prose about fees, dates or eligibility.
# AI_PROVIDER can pin a specific provider: openai | anthropic | google
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GOOGLE_AI_API_KEY=xxx
# GOOGLE_AI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Google Maps Platform (optional). Without a key CareerBridge shows a schematic
# map, straight-line distances and keyless Google Maps links.
# Restrict this key by HTTP referrer in the Google Cloud console.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=xxx
